{
  "name": "minimaas",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "pnpm --parallel --filter @minimaas/gateway --filter @minimaas/control-plane --filter @minimaas/console dev",
