# MiniMaaS 本身的本地开发配置，不包含任何真实供应商密钥。
GATEWAY_PORT=8080
CONTROL_PLANE_PORT=8081
CONSOLE_PORT=5173
LOG_LEVEL=info
DATABASE_URL=postgresql://minimaas:minimaas@localhost:5432/minimaas
# memory 开箱即用；postgres 持久化租户、API Key 与配额。
TENANT_STORE_BACKEND=memory
REDIS_URL=redis://localhost:6379
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:0.5b
# mock 保持开箱即用；改为 ollama 后 smart-chat 将路由到本地模型。
DEFAULT_MODEL_PROVIDER=mock
PROVIDER_TIMEOUT_MS=30000
AUTH_MODE=control-plane
CONTROL_PLANE_URL=http://127.0.0.1:8081
AUTH_SNAPSHOT_TTL_MS=2000
# memory 保持开箱即用；redis 使用 Lua 脚本保证 RPM/TPM 原子检查。
RATE_LIMIT_BACKEND=memory
# 日 Token 与月预算同样支持 Redis 原子预占和实际用量结算。
QUOTA_BACKEND=memory
VITE_CONTROL_PLANE_URL=http://localhost:8081
VITE_GATEWAY_URL=http://localhost:8080
